{
  "name": "mineflayer-headless-render",
  "version": "0.1.2",
  "description": "Headless POV frame capture for mineflayer bots: software rasterizer, no GPU or canvas",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikonP/mineflayer-headless-render.git"
  },
  "keywords": [
    "mineflayer",
    "minecraft",
    "render",
    "headless",
    "software-rasterizer",
    "pov"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "vendor",
    "scripts",
    "docs/*.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bin": {
    "mineflayer-headless-render-setup": "scripts/setup-assets.sh"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "example:capture": "node examples/capture.js",
    "example:live": "node examples/live.js",
    "example:arena": "node examples/arena.js",
    "bench": "node bench/bench.js",
    "test": "node test/cache.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run lint && npm run format:check"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "minecraft-assets": "^1.19.0",
    "minecraft-data": "^3.116.0",
    "pngjs": "^7.0.0",
    "vec3": "^0.2.0"
  },
  "peerDependencies": {
    "mineflayer": ">=4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "mineflayer": "^4.39.0",
    "neostandard": "^0.13.0",
    "prettier": "^3.9.8",
    "prettier-config-standard": "^7.0.0"
  }
}
